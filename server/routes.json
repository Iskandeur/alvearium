{
  "//": "Contrat des routes de l'API d'Alvearium. Chaque route que le serveur sert ou que la page appelle y figure, avec ce qu'un PROXY d'authentification placé devant le serveur doit en faire : proxy true = à laisser passer (la page ou un client en dépend), false = à refuser (la raison est dans note), \"ingest\" = la porte publique des hooks. Ajouter une route côté serveur ou page sans l'ajouter ici fait échouer test/routes-contrat.test.mjs. Un proxy (par exemple le tableau de bord d'une installation) lit ce fichier pour vérifier sa liste blanche : sans cela, une fonction livrée reste invisible derrière lui. `example` donne un chemin concret pour une route à paramètres.",
  "version": 1,
  "routes": [
    { "method": "POST", "path": "/api/event", "from": ["clients"], "proxy": "ingest", "note": "les hooks ; URL exacte, porte publique du proxy" },
    { "method": "GET", "path": "/api/version", "from": ["clients"], "proxy": true },
    { "method": "GET", "path": "/api/changelog", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/import", "from": ["clients"], "proxy": true },
    { "method": "GET", "path": "/api/board", "from": ["clients"], "proxy": true },
    { "method": "POST", "path": "/api/dismiss", "from": ["clients"], "proxy": true },
    { "method": "GET", "path": "/api/tickets", "from": ["page", "clients"], "proxy": true },
    { "method": "POST", "path": "/api/tickets", "from": ["page", "clients"], "proxy": true },
    { "method": "GET", "path": "/api/tickets/board", "from": ["page", "clients"], "proxy": true },
    { "method": "GET", "path": "/api/tickets/next", "from": ["page", "clients"], "proxy": true },
    { "method": "GET", "path": "/api/tickets/:key", "from": ["page", "clients"], "proxy": true, "example": "/api/tickets/ALV-1" },
    { "method": "POST", "path": "/api/tickets/:key", "from": ["page", "clients"], "proxy": true, "example": "/api/tickets/ALV-1" },
    { "method": "PATCH", "path": "/api/tickets/:key", "from": ["clients"], "proxy": true, "example": "/api/tickets/ALV-1" },
    { "method": "POST", "path": "/api/tickets/:key/comments", "from": ["page", "clients"], "proxy": true, "example": "/api/tickets/ALV-1/comments" },
    { "method": "POST", "path": "/api/tickets/:key/move", "from": ["page", "clients"], "proxy": true, "example": "/api/tickets/ALV-1/move" },
    { "method": "POST", "path": "/api/tickets/:key/answer", "from": ["page"], "proxy": true, "example": "/api/tickets/ALV-1/answer" },
    { "method": "GET", "path": "/api/unread", "from": ["page", "clients"], "proxy": true },
    { "method": "POST", "path": "/api/tickets/:key/seen", "from": ["page"], "proxy": true, "example": "/api/tickets/ALV-1/seen" },
    { "method": "POST", "path": "/api/tickets/:key/actions/:id", "from": ["page"], "proxy": true, "example": "/api/tickets/ALV-1/actions/claude-code" },
    { "method": "GET", "path": "/api/actions", "from": ["page"], "proxy": true },
    { "method": "GET", "path": "/api/stream", "from": ["page", "clients"], "proxy": true },
    { "method": "GET", "path": "/api/roi", "from": ["clients"], "proxy": false, "note": "lue et postée par l'installation, en direct sur le serveur ; la page lit les scores dans les tickets" },
    { "method": "PUT", "path": "/api/roi", "from": ["clients"], "proxy": false, "note": "idem : jamais par le navigateur" },
    { "method": "GET", "path": "/api/actors", "from": ["page", "clients"], "proxy": true },
    { "method": "POST", "path": "/api/tickets/:key/attachments", "from": ["page", "clients"], "proxy": true, "example": "/api/tickets/ALV-1/attachments", "max_body": 27262976, "body": "raw", "note": "un fichier, octets bruts (tout type) ; ?name= son nom ; plafond BOARD_ATTACHMENT_MAX_MB (25 Mo par défaut) : max_body suit ce plafond, avec 1 Mo de marge" },
    { "method": "POST", "path": "/api/attachments", "from": ["page", "clients"], "proxy": true, "max_body": 27262976, "body": "raw", "note": "idem, avant que l'alvéole existe (formulaire de nouvelle alvéole) ; la création la réclame" },
    { "method": "GET", "path": "/api/attachments/:id", "from": ["page"], "proxy": true, "example": "/api/attachments/1", "headers": ["content-disposition", "x-content-type-options", "content-security-policy", "etag"], "note": "le proxy relaie ces en-têtes de réponse tels quels" },
    { "method": "GET", "path": "/api/actors/:id/avatar", "from": ["page"], "proxy": true, "example": "/api/actors/user/avatar" },
    { "method": "PUT", "path": "/api/actors/:id/avatar", "from": ["page"], "proxy": true, "example": "/api/actors/user/avatar" },
    { "method": "DELETE", "path": "/api/actors/:id/avatar", "from": ["page"], "proxy": true, "example": "/api/actors/user/avatar" },
    { "method": "PATCH", "path": "/api/actors/:id", "from": ["page"], "proxy": true, "example": "/api/actors/user" },
    { "method": "POST", "path": "/api/actors/:id", "from": ["clients"], "proxy": true, "example": "/api/actors/user" },
    { "method": "GET", "path": "/api/facets", "from": ["page", "clients"], "proxy": true },
    { "method": "GET", "path": "/api/sessions", "from": ["clients"], "proxy": true },
    { "method": "DELETE", "path": "/api/sessions/:id", "from": ["clients"], "proxy": true, "example": "/api/sessions/s1" },
    { "method": "GET", "path": "/api/me", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/session", "from": ["page"], "proxy": false, "note": "échange un jeton contre un cookie : le proxy porte déjà son propre Bearer, un cookie du serveur n'y a pas de sens" },
    { "method": "POST", "path": "/api/logout", "from": ["page"], "proxy": false, "note": "idem : pas de session de page derrière le proxy" },
    { "method": "GET", "path": "/api/members", "from": ["page"], "proxy": true },
    { "method": "PATCH", "path": "/api/members/:id", "from": ["page"], "proxy": true, "example": "/api/members/user" },
    { "method": "POST", "path": "/api/members/:id", "from": ["clients"], "proxy": true, "example": "/api/members/user" },
    { "method": "DELETE", "path": "/api/members/:id", "from": ["page"], "proxy": true, "example": "/api/members/user" },
    { "method": "GET", "path": "/api/tokens", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/tokens", "from": ["page"], "proxy": true },
    { "method": "DELETE", "path": "/api/tokens/:id", "from": ["page"], "proxy": true, "example": "/api/tokens/tk_0123456789ab" },
    { "method": "GET", "path": "/api/audit", "from": ["page"], "proxy": true },
    { "method": "GET", "path": "/api/invites", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/invites", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/invites/check", "from": ["page"], "proxy": true },
    { "method": "POST", "path": "/api/invites/accept", "from": ["page"], "proxy": false, "note": "avant authentification, pour une personne invitée sur SON instance ; derrière le proxy elle agirait avec le Bearer du propriétaire" },
    { "method": "DELETE", "path": "/api/invites/:id", "from": ["page"], "proxy": true, "example": "/api/invites/inv_0123456789ab" }
  ]
}
